// SOLO si activás Firebase Storage (opcional, requiere plan Blaze).
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /imagenes/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email in ['TU_CORREO@gmail.com']
                   && request.resource.size < 8 * 1024 * 1024;   // máx. 8 MB por foto
      allow delete: if request.auth != null
                    && request.auth.token.email in ['TU_CORREO@gmail.com'];
    }
  }
}
